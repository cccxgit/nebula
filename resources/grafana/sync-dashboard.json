{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "NebulaGraph Cross-Cluster Sync Monitoring Dashboard",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Sync Lag Overview",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Log ID Gap",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sync_log_id_lag{job=\"nebula-drainerd\"}",
          "legendFormat": "space={{space_id}} part={{part_id}}",
          "refId": "A"
        }
      ],
      "title": "Sync Log ID Lag per Partition",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "max(sync_log_id_lag{job=\"nebula-drainerd\"}) by (space_id)",
          "legendFormat": "space={{space_id}}",
          "refId": "A"
        }
      ],
      "title": "Max Sync Lag (per Space)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Apply Throughput",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "entries/sec",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(sync_entries_applied{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "{{instance}} part={{part_id}}",
          "refId": "A"
        }
      ],
      "title": "Sync Entries Applied (rate)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "bytes/sec",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(sync_bytes_applied{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "{{instance}} part={{part_id}}",
          "refId": "A"
        }
      ],
      "title": "Sync Bytes Applied (rate)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "targets": [
        {
          "expr": "rate(sync_batches_applied{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "applied {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(sync_batches_failed{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "failed {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Batch Apply Rate (applied vs failed)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "targets": [
        {
          "expr": "rate(sync_batches_received{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "received {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Batches Received Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 9,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "latency (ms)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 10,
      "targets": [
        {
          "expr": "sync_transport_latency_ms_p50{job=\"nebula-drainerd\"}",
          "legendFormat": "p50 {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sync_transport_latency_ms_p95{job=\"nebula-drainerd\"}",
          "legendFormat": "p95 {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sync_transport_latency_ms_p99{job=\"nebula-drainerd\"}",
          "legendFormat": "p99 {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Transport Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "latency (us)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "µs"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 11,
      "targets": [
        {
          "expr": "sync_apply_latency_us_p75{job=\"nebula-drainerd\"}",
          "legendFormat": "p75 {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sync_apply_latency_us_p95{job=\"nebula-drainerd\"}",
          "legendFormat": "p95 {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sync_apply_latency_us_p99{job=\"nebula-drainerd\"}",
          "legendFormat": "p99 {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Apply Latency (p75 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 12,
      "title": "Schema Barrier",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "id": 13,
      "targets": [
        {
          "expr": "rate(schema_barrier_waits{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "waits {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(schema_barrier_timeouts{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "timeouts {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Schema Barrier Waits & Timeouts",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "id": 14,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "increase(schema_barrier_timeouts{job=\"nebula-drainerd\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Schema Barrier Timeouts (last 5m)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "id": 15,
      "title": "Epoch Fencing & Alerts",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "id": 16,
      "targets": [
        {
          "expr": "rate(epoch_mismatch_total{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "epoch_mismatch {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(cluster_loop_total{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "cluster_loop {{instance}}",
          "refId": "B"
        },
        {
          "expr": "rate(auth_failed_total{job=\"nebula-drainerd\"}[$__rate_interval])",
          "legendFormat": "auth_failed {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Epoch Mismatch / Cluster Loop / Auth Failures",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "id": 17,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "increase(epoch_mismatch_total{job=\"nebula-drainerd\"}[5m])",
          "legendFormat": "Epoch Mismatch (5m)",
          "refId": "A"
        },
        {
          "expr": "increase(cluster_loop_total{job=\"nebula-drainerd\"}[5m])",
          "legendFormat": "Cluster Loop (5m)",
          "refId": "B"
        },
        {
          "expr": "increase(auth_failed_total{job=\"nebula-drainerd\"}[5m])",
          "legendFormat": "Auth Failed (5m)",
          "refId": "C"
        }
      ],
      "title": "Epoch Fencing Alert Counters (last 5m)",
      "type": "stat"
