INSERT VERTEX ftcase(title,body) VALUES "r5":("aquatic watercraft","water river water");
INSERT VERTEX ftcase(title,body) VALUES "r6":("beach","sand dry");
INSERT VERTEX ftcase(title,body) VALUES "r7":("New York","quoted \"fox\" and C++");
