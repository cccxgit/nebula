# Proxy Nebula's buffered WAL with sequential writes and a 16 MiB fsync interval.
[global]
filename=${WAL_FILE}
size=${WAL_TEST_SIZE}
ioengine=psync
direct=0
invalidate=1
fallocate=none
rw=write
bs=4k
iodepth=1
numjobs=1
fsync=4096
end_fsync=1
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP_TIME}
thread=1
group_reporting=1
refill_buffers=1
clat_percentiles=1
lat_percentiles=1
percentile_list=50:95:99:99.9

[raft_wal]
